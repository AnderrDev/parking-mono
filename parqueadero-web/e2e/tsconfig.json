{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "dom"]
  },
  "include": [
    "specs/**/*.ts",
    "fixtures/**/*.ts",
    "utils/**/*.ts"
  ]
}
