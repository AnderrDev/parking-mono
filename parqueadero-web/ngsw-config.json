{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "supabase-catalogos",
      "urls": [
        "**/rest/v1/tariffs*",
        "**/rest/v1/monthly_plans*",
        "**/rest/v1/customers*",
        "**/rest/v1/vehicles*",
        "**/rest/v1/app_settings*"
      ],
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "1h",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "supabase-mutaciones",
      "urls": [
        "**/rest/v1/parking_sessions*",
        "**/rest/v1/payments*",
        "**/rest/v1/invoices*",
        "**/rest/v1/cashier_shifts*"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "5m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    }
  ]
}
