# Copia a .env (no commitear). Usado por scripts y supabase CLI cuando linkeamos remoto.

# Conexión a la BD remota (en producción). Para local, supabase start expone su propia URL.
SUPABASE_DB_URL=

# Anon key + service role (los entrega supabase status / dashboard).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Microservicio DIAN. Si vacío, Edge Function request-invoice usa stub local (Fase 9).
DIAN_FE_SERVICE_URL=

# Wompi (pagos online; pendiente Fase 6+).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
