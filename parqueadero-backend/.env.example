# Copia a .env (no commitear). Usado por scripts y supabase CLI cuando linkeamos remoto.

# Conexión a la BD remota (en producción). Para local, supabase start expone su propia URL.
SUPABASE_DB_URL=

# Anon key + service role (los entrega supabase status / dashboard).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Microservicio DIAN. DEPRECADO en Fase 11 / S9 (cutover Siigo).
# Mientras `siigo-emit-invoice` no esté en cutover total, request-invoice
# (legacy) puede seguir usándolo. Si vacío, request-invoice usa stub local.
DIAN_FE_SERVICE_URL=

# === Siigo (Fase 11 — facturación electrónica) ===
# Solicitar credenciales sandbox a soporteapi@siigo.com.
# Producción: portal Siigo Nube → Configuración → API.
SIIGO_BASE_URL=https://api.siigo.com
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
# IDs de catálogo Siigo Nube (pre-cargados):
SIIGO_PRODUCT_ID_PARKING_HOUR=
# Opcionales (si se usan):
# SIIGO_PRODUCT_ID_MONTHLY_PLAN=
# SIIGO_PRODUCT_ID_DAILY_CAP=

# PowerSync (sincronización offline).
# Local dev: http://localhost:8080 (docker-compose.powersync.yml)
# Producción: URL del proyecto en app.powersync.com
POWERSYNC_URL=

# Wompi (pagos online; pendiente Fase 6+).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
